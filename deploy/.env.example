# Copy to deploy/.env on the server (bin/deploy setup does this) and fill in.
# Never commit deploy/.env.

# Hostname for the API (HTTPS via Caddy). Without a domain, use sslip.io:
# api.<server-ip-with-dashes>.sslip.io, e.g. api.152-67-1-2.sslip.io
API_HOST=
API_HOSTS=

# The deployed frontend, e.g. https://nepse-journal.pages.dev (comma-separate several).
FRONTEND_ORIGINS=

# Secrets: generated by bin/deploy setup, except RAILS_MASTER_KEY (from config/master.key).
RAILS_MASTER_KEY=
JWT_SECRET=
NEPSE_TRADE_JOURNAL_DATABASE_PASSWORD=

# Optional: the Telegram bot token, if it isn't in the encrypted credentials.
# TELEGRAM_BOT_TOKEN=
