#!/usr/bin/env bash
# Deploys the API to one server over SSH (see deploy/README.md).
#
#   bin/deploy setup        one-time: install Docker, firewall, backups; create deploy/.env
#   bin/deploy push         copy the code, rebuild and restart (migrations run on start)
#   bin/deploy copy-data    replace the server's database with your local development data
#   bin/deploy status|logs|console|backup
#
# Target: DEPLOY_HOST (e.g. ubuntu@152.67.1.2) and DEPLOY_KEY (default ~/.ssh/nepse_oracle_ed25519),
# from the environment or deploy/target.env. FRONTEND_ORIGINS is needed for setup.
set -euo pipefail
cd "$(dirname "$0")/.."

[ -f deploy/target.env ] && source deploy/target.env
: "${DEPLOY_HOST:?Set DEPLOY_HOST=ubuntu@<server-ip> (or put it in deploy/target.env)}"
DEPLOY_KEY="${DEPLOY_KEY:-$HOME/.ssh/nepse_oracle_ed25519}"
APP_DIR="nepse-journal"
SSH=(ssh -i "$DEPLOY_KEY" -o StrictHostKeyChecking=accept-new "$DEPLOY_HOST")
remote() { "${SSH[@]}" "$@"; }
compose() { remote "cd $APP_DIR/deploy && docker compose $*"; }

sync_code() {
  rsync -az --delete -e "ssh -i $DEPLOY_KEY -o StrictHostKeyChecking=accept-new" \
    --exclude .git --exclude node_modules --exclude /frontend --exclude /tmp --exclude /log --exclude /storage \
    --exclude /config/master.key --exclude /deploy/.env --exclude /deploy/target.env --exclude /backups --exclude .env \
    ./ "$DEPLOY_HOST:$APP_DIR/"
}

case "${1:-}" in
  setup)
    : "${FRONTEND_ORIGINS:?Set FRONTEND_ORIGINS=https://<your-project>.pages.dev}"
    sync_code
    remote "bash $APP_DIR/deploy/server-setup.sh"
    ip=$(remote "curl -fsS https://api.ipify.org")
    api_host="${API_HOST:-api.${ip//./-}.sslip.io}"
    if remote "test -f $APP_DIR/deploy/.env"; then
      echo "deploy/.env already exists on the server; leaving it as it is."
    else
      # Secrets are generated on the server; only the Rails master key is copied from this machine.
      master_key=$(cat config/master.key)
      remote "umask 077 && cat > $APP_DIR/deploy/.env" <<ENV
API_HOST=$api_host
API_HOSTS=$api_host
FRONTEND_ORIGINS=$FRONTEND_ORIGINS
RAILS_MASTER_KEY=$master_key
JWT_SECRET=$(openssl rand -hex 64)
NEPSE_TRADE_JOURNAL_DATABASE_PASSWORD=$(openssl rand -hex 24)
ENV
      echo "Created deploy/.env on the server."
    fi
    echo "API will be at https://$api_host"
    ;;
  push)
    sync_code
    compose "up -d --build"
    compose "ps"
    ;;
  copy-data)
    local_db="${LOCAL_DB:-nepse_trade_journal_development}"
    dump="tmp/nepse_local_$(date +%Y%m%d_%H%M).dump"
    pg_dump -Fc --no-owner --no-acl "$local_db" > "$dump"
    echo "Dumped $local_db ($(du -h "$dump" | cut -f1))"
    scp -i "$DEPLOY_KEY" "$dump" "$DEPLOY_HOST:$APP_DIR/backups/import.dump"
    compose "stop web"
    compose "exec -T db pg_restore -U nepse_trade_journal -d nepse_trade_journal_production --clean --if-exists --no-owner --no-acl < ../backups/import.dump" || true
    compose "start web"
    rm -f "$dump"
    echo "Data copied. Run: bin/deploy console  ->  then set your password (see deploy/README.md)."
    ;;
  status) compose "ps" ;;
  logs) compose "logs --tail=200 -f web" ;;
  console) "${SSH[@]}" -t "cd $APP_DIR/deploy && docker compose exec web bash" ;;
  backup) remote "cd $APP_DIR/deploy && ./backup.sh" ;;
  *) sed -n '2,12p' "$0"; exit 1 ;;
esac
